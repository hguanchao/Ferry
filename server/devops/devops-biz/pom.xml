<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.ferry</groupId>
        <artifactId>devops</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>devops-biz</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>common-web</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- AI 能力由 common-ai 统一封装：模型配置与提示词均在其内管理 -->
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>common-ai</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>common-cache</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>common-security</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>devops-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>system-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 测试：junit5 + mockito，版本由 spring-boot-dependencies BOM 管理；Jenkins 联调用 Mock -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Maven 超级 POM 默认 surefire 2.12.4 不支持 JUnit5，固定为 3.x 以运行单元测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>
        </plugins>
    </build>
</project>
