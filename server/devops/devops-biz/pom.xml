<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.ferry</groupId>
        <artifactId>devops</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>devops-biz</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>common-web</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- AI 能力由 common-ai 统一封装：模型配置与提示词均在其内管理 -->
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>common-ai</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>common-cache</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>common-security</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>devops-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ferry</groupId>
            <artifactId>system-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring AI 由 common-ai 以 compile scope 传递，勿在此以 test scope 重复声明：
             直接声明会覆盖传递依赖的 scope，导致运行时 classpath 缺失 ChatClient，
             AiAutoConfiguration 的 @ConditionalOnClass 不满足，AI 能力整体降级。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
