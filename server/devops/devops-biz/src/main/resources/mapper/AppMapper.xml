<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ferry.devops.biz.mapper.AppMapper">
    <resultMap id="BaseResultMap" type="com.ferry.devops.api.entity.App">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="code" jdbcType="VARCHAR" property="code"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="dept_id" jdbcType="BIGINT" property="deptId"/>
        <result column="owner_ids" jdbcType="VARCHAR" property="ownerIds"/>
        <result column="owner_names" jdbcType="VARCHAR" property="ownerNames"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="is_core" jdbcType="TINYINT" property="isCore"/>
        <result column="status" jdbcType="TINYINT" property="status"/>
        <result column="repo_type" jdbcType="VARCHAR" property="repoType"/>
        <result column="repo_url" jdbcType="VARCHAR" property="repoUrl"/>
        <result column="repo_branch" jdbcType="VARCHAR" property="repoBranch"/>
        <result column="repo_commit_id" jdbcType="VARCHAR" property="repoCommitId"/>
        <result column="repo_token" jdbcType="BIGINT" property="repoToken"/>
        <result column="create_user" jdbcType="BIGINT" property="createUser"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_user" jdbcType="BIGINT" property="updateUser"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="is_deleted" jdbcType="TINYINT" property="isDeleted"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, code, name, dept_id, owner_ids, owner_names, description, is_core, status, repo_type, repo_url,
        repo_branch, repo_commit_id, repo_token, create_user, create_time, update_user, update_time, is_deleted
    </sql>

    <select id="selectCodeCount" resultType="long">
        SELECT COUNT(1)
        FROM dev_app
        <where>
            code = #{code}
            <if test="id != null">
                AND id != #{id}
            </if>
        </where>
    </select>

    <select id="selectPageList" resultType="com.ferry.devops.api.vo.AppVO">
        SELECT id,
               code,
               name,
               dept_id        AS deptId,
               owner_ids      AS ownerIds,
               owner_names    AS ownerNames,
               description,
               is_core        AS isCore,
               status,
               repo_type      AS repoType,
               repo_url       AS repoUrl,
               repo_branch    AS repoBranch,
               repo_commit_id AS repoCommitId,
               repo_token     AS repoToken,
               create_time    AS createTime
        FROM dev_app
        <where>
            is_deleted = 0
            <if test="query.keyword != null and query.keyword != ''">
                AND (code LIKE CONCAT('%', #{query.keyword}, '%') OR name LIKE CONCAT('%', #{query.keyword}, '%'))
            </if>
            <if test="query.deptIds != null and query.deptIds.size() > 0">
                AND dept_id IN
                <foreach collection="query.deptIds" item="deptId" open="(" separator="," close=")">
                    #{deptId}
                </foreach>
            </if>
            <if test="query.ownerIds != null and query.ownerIds.size() > 0">
                AND (<foreach collection="query.ownerIds" item="ownerId" separator=" OR ">
                FIND_IN_SET(#{ownerId}, owner_ids)
            </foreach>)
            </if>
            <if test="query.repoTypes != null and query.repoTypes.size() > 0">
                AND repo_type IN
                <foreach collection="query.repoTypes" item="repoType" open="(" separator="," close=")">
                    #{repoType}
                </foreach>
            </if>
            <if test="query.isCore != null">
                AND is_core = #{query.isCore}
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
