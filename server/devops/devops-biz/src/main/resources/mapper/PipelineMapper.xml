<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ferry.devops.biz.mapper.PipelineMapper">
    <resultMap id="BaseResultMap" type="com.ferry.devops.api.entity.Pipeline">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="status" jdbcType="TINYINT" property="status"/>
        <result column="app_id" jdbcType="BIGINT" property="appId"/>
        <result column="version" jdbcType="INTEGER" property="version"/>
        <result column="create_user" jdbcType="BIGINT" property="createUser"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_user" jdbcType="BIGINT" property="updateUser"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="is_deleted" jdbcType="TINYINT" property="isDeleted"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, `name`, `status`, app_id, version, create_user, create_time, update_user, update_time,
        is_deleted
    </sql>

    <select id="selectPageList" resultType="com.ferry.devops.api.vo.PipelineVO">
        SELECT p.id                     AS id,
               p.app_id                 AS appId,
               a.name                   AS appName,
               a.repo_branch            AS repoBranch,
               p.name                   AS name,
               p.status                 AS status,
               p.version                AS version,
               (SELECT COUNT(1)
                FROM dev_pipeline_stage s
                WHERE s.pipeline_id = p.id
                  AND s.version = p.version
                  AND s.is_deleted = 0) AS stageCount,
               p.create_time            AS createTime,
               p.update_time            AS updateTime
        FROM dev_pipeline p
                 LEFT JOIN dev_app a ON a.id = p.app_id AND a.is_deleted = 0
        <where>
            p.is_deleted = 0
            <if test="query.appIds != null and query.appIds.size() > 0">
                AND p.app_id IN
                <foreach collection="query.appIds" item="appId" open="(" separator="," close=")">
                    #{appId}
                </foreach>
            </if>
            <if test="query.name != null and query.name != ''">
                AND p.name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.status != null">
                AND p.status = #{query.status}
            </if>
        </where>
        ORDER BY p.create_time DESC, p.id DESC
    </select>
</mapper>
