<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ferry.devops.biz.mapper.PipelineMapper">
    <resultMap id="BaseResultMap" type="com.ferry.devops.api.entity.Pipeline">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="app_id" jdbcType="BIGINT" property="appId"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="current_version_id" jdbcType="BIGINT" property="currentVersionId"/>
        <result column="current_version_no" jdbcType="INTEGER" property="currentVersionNo"/>
        <result column="stage_count" jdbcType="INTEGER" property="stageCount"/>
        <result column="create_user" jdbcType="BIGINT" property="createUser"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_user" jdbcType="BIGINT" property="updateUser"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="is_deleted" jdbcType="TINYINT" property="isDeleted"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, app_id, name, description, current_version_id, current_version_no, stage_count,
        create_user, create_time, update_user, update_time, is_deleted
    </sql>

    <select id="selectPageList" resultType="com.ferry.devops.api.vo.PipelineVO">
        SELECT p.id,
               p.app_id             AS appId,
               a.code               AS appCode,
               a.name               AS appName,
               p.name,
               p.description,
               p.current_version_id AS currentVersionId,
               p.current_version_no AS currentVersionNo,
               p.stage_count        AS stageCount,
               a.repo_branch        AS defaultBranch,
               a.owner_names        AS ownerNames,
               p.create_time        AS createTime,
               p.update_time        AS updateTime
        FROM dev_pipeline p
                 INNER JOIN dev_app a ON a.id = p.app_id AND a.is_deleted = 0
        <where>
            p.is_deleted = 0
            <if test="query.keyword != null and query.keyword != ''">
                AND p.name LIKE CONCAT('%', #{query.keyword}, '%')
            </if>
            <if test="query.ids != null and query.ids.size() > 0">
                AND p.id IN
                <foreach collection="query.ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="query.appIds != null and query.appIds.size() > 0">
                AND p.app_id IN
                <foreach collection="query.appIds" item="appId" open="(" separator="," close=")">
                    #{appId}
                </foreach>
            </if>
            <if test="query.ownerIds != null and query.ownerIds.size() > 0">
                AND (
                <foreach collection="query.ownerIds" item="ownerId" separator=" OR ">
                    FIND_IN_SET(#{ownerId}, a.owner_ids) > 0
                </foreach>
                )
            </if>
        </where>
        ORDER BY p.update_time DESC
    </select>
</mapper>
