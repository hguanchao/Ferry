<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ferry.system.biz.mapper.RoleMenuMapper">
    <resultMap id="BaseResultMap" type="com.ferry.system.api.entity.RoleMenu">
        <result column="role_id" jdbcType="BIGINT" property="roleId"/>
        <result column="menu_id" jdbcType="BIGINT" property="menuId"/>
    </resultMap>
    <sql id="Base_Column_List">
        role_id, menu_id
    </sql>

    <select id="selectRoleMenuListByRoleId" resultType="com.ferry.system.api.entity.Menu">
        SELECT id,
               tenant_id AS tenantId,
               parent_id AS parentId,
               name,
               type,
               icon,
               path,
               component,
               perms,
               is_show   AS isShow,
               is_frame  AS isFrame,
               is_cache  AS isCache,
               status,
               sort
        FROM sys_menu
        <where>
            status = 1 AND is_deleted = 0
            <if test="roleIds != null and roleIds != ''">
                AND id IN (SELECT DISTINCT menu_id FROM sys_role_menu WHERE FIND_IN_SET(role_id, #{roleIds}))
            </if>
        </where>
    </select>
</mapper>